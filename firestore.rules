rules_version = '2';

// SDE · EsFO — Regras de segurança do Firestore (semana fecha sexta 18h · fato até 24h no nível 2 · sem CPF · sem anulação · NAMCE e Planilha travadas · imagem na defesa · exclusão na semana aberta · cadete com e-mail @pm.pr.gov.br · ciência automática · ciência da NAMCE · unir cadastros duplicados)
// Copie TODO este conteúdo para: Firebase → Firestore Database → aba "Regras" → Publicar.
// Tudo o que não está liberado aqui é bloqueado.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() { return request.auth != null; }
    function caminhoPerfil(uid) { return /databases/$(database)/documents/usuarios/$(uid); }
    function caminhoConfig() { return /databases/$(database)/documents/config/sistema; }
    function eu() { return get(caminhoPerfil(request.auth.uid)).data; }
    function ativo() {
      return logado() && exists(caminhoPerfil(request.auth.uid)) && eu().status == 'ativo';
    }
    function nivel(n) { return ativo() && eu().nivel >= n; }
    function txt(s, a, b) { return s is string && s.size() >= a && s.size() <= b; }

    // Dados de um pedido de acesso (criado pelo próprio usuário)
    function pedidoValido(d, uid) {
      return d.keys().hasAll(['tipo', 'nome', 'guerra', 'email', 'nivel', 'status', 'criadoEm'])
        && d.keys().hasOnly(['tipo', 'nome', 'guerra', 'ano', 'turma', 'pelotao', 'posto',
                             'email', 'nivel', 'status', 'criadoEm'])
        && txt(d.nome, 3, 120)
        && txt(d.guerra, 2, 40)
        && d.email == request.auth.token.email
        && d.criadoEm == request.time
        && (
          (d.tipo == 'cadete'
             && d.email.lower().matches('^[^@]+@pm[.]pr[.]gov[.]br$')     // cadete: só e-mail institucional
             && d.ano in ['1º CFO', '2º CFO', '3º CFO', 'CHOE']
             && txt(d.turma, 0, 3)
             && txt(d.pelotao, 1, 3))
          || (d.tipo == 'coordenacao' && txt(d.posto, 2, 40))
        );
    }

    function cadeteValido(d) {
      return d.keys().hasOnly(['nome', 'guerra', 'ano', 'turma', 'pelotao', 'uid',
                               'ativo', 'criadoEm', 'atualizadoEm', 'unidoA', 'unidoEm'])
        && txt(d.nome, 3, 120)
        && txt(d.guerra, 2, 40)
        && d.ano in ['1º CFO', '2º CFO', '3º CFO', 'CHOE']
        && txt(d.turma, 0, 3)
        && txt(d.pelotao, 1, 3)
        && d.ativo is bool;
    }

    // ---------- Configuração geral ----------
    // Existe a partir do momento em que o primeiro administrador se cadastra.
    match /config/sistema {
      allow get: if logado();
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['adminInicial', 'criadoEm'])
        && request.resource.data.adminInicial == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && getAfter(caminhoPerfil(request.auth.uid)).data.nivel == 3;
      allow update, delete: if false;
    }
    // Marca de que os CPFs antigos já foram apagados
    match /config/semCpf {
      allow get, create: if nivel(3);
      allow update, delete: if false;
    }

    // ---------- Usuários (contas de acesso) ----------
    match /usuarios/{uid} {
      // cada um lê o próprio perfil; o nível 3 lê todos
      allow get: if logado() && (request.auth.uid == uid || nivel(3));
      allow list: if nivel(3);

      // pedido de acesso: sempre pendente e nível 0...
      // ...exceto o primeiro usuário do sistema, que vira administrador (nível 3)
      allow create: if logado()
        && request.auth.uid == uid
        && pedidoValido(request.resource.data, uid)
        && (
          (request.resource.data.nivel == 0 && request.resource.data.status == 'pendente')
          || (request.resource.data.nivel == 3
              && request.resource.data.status == 'ativo'
              && !exists(caminhoConfig())
              && getAfter(caminhoConfig()).data.adminInicial == uid)
        );

      // só o nível 3 aprova, recusa, bloqueia e muda nível; o usuário não altera o próprio perfil
      allow update: if nivel(3)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nivel', 'status', 'cadeteId', 'analisadoPor', 'analisadoEm',
                       'nome', 'guerra', 'ano', 'turma', 'pelotao', 'posto', 'cpf'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cpf'])
            || !request.resource.data.keys().hasAny(['cpf']))     // CPF antigo só pode ser apagado
        && request.resource.data.nivel in [0, 1, 2, 3]
        && request.resource.data.status in ['pendente', 'ativo', 'recusado', 'bloqueado'];

      allow delete: if nivel(3);
    }

    // ---------- CPFs antigos: o sistema não guarda mais CPF; o nível 3 só pode apagar o que restou ----------
    match /cpfs/{cpf} {
      allow list, delete: if nivel(3);
      allow get, create, update: if false;
    }
    match /cpfCadete/{cpf} {
      allow list, delete: if nivel(3);
      allow get, create, update: if false;
    }

    // ---------- Cadetes ----------
    // Nome, nome de guerra, turma e pelotão: visíveis a todos os usuários ativos.
    match /cadetes/{id} {
      allow read: if ativo();
      allow create, update: if nivel(3) && cadeteValido(request.resource.data);
      allow delete: if nivel(3);

      // Dados antigos com CPF: só podem ser apagados.
      match /privado/{docId} {
        allow delete: if nivel(3);
        allow read, create, update: if false;
      }
    }

    // ---------- Anotações (AAD e FO+) ----------
    function meuCadete() { return eu().get('cadeteId', ''); }

    // Semana de anotações: fecha na sexta-feira às 18h de Brasília (sexta 21:00 UTC), pela hora do lançamento.
    // Prazo da defesa = segunda-feira seguinte ao fechamento, 23h59min59s (terça 02:59:59 UTC).
    // Logo, o fechamento (prazo − 3d 5h59min59s) tem de estar no futuro e a no máximo 7 dias.
    function prazoValido(p) {
      return p is timestamp
        && p > request.time + duration.value(280799, 's')
        && p <= request.time + duration.value(885599, 's')
        && p.dayOfWeek() == 2
        && p.hours() == 2 && p.minutes() == 59;
    }

    function anotacaoValida(d) {
      let c = get(/databases/$(database)/documents/cadetes/$(d.cadeteId)).data;
      return d.keys().hasAll(['tipo', 'cadeteId', 'cadeteNome', 'cadeteGuerra', 'cadeteAno', 'cadeteTurma',
                              'cadetePelotao', 'anotadorUid', 'anotadorNome', 'descricao', 'fatoEm',
                              'criadoEm', 'prazo'])
        && d.keys().hasOnly(['tipo', 'cadeteId', 'cadeteNome', 'cadeteGuerra', 'cadeteAno', 'cadeteTurma',
                             'cadetePelotao', 'anotadorUid', 'anotadorNome', 'descricao', 'fatoEm',
                             'criadoEm', 'prazo'])
        && d.tipo in ['aad', 'fo']
        && c.ativo == true
        && d.cadeteNome == c.nome && d.cadeteGuerra == c.guerra && d.cadeteAno == c.ano
        && d.cadeteTurma == c.turma && d.cadetePelotao == c.pelotao
        && d.cadeteId != meuCadete()                 // ninguém se anota
        && d.anotadorUid == request.auth.uid
        && txt(d.anotadorNome, 2, 60)
        && txt(d.descricao, 5, 1000)
        && d.fatoEm is timestamp
        && d.fatoEm <= request.time + duration.value(10, 'm')
        && (nivel(3) || d.fatoEm >= request.time - duration.value(24, 'h'))     // nível 2: fato de no máximo 24 horas antes; nível 3 sem limite
        && d.criadoEm == request.time
        && prazoValido(d.prazo);
    }

    match /anotacoes/{aid} {
      // nível 3 vê tudo; o cadete vê as que recebeu; o anotador vê as que lançou
      allow read: if nivel(3)
        || (ativo() && (resource.data.anotadorUid == request.auth.uid
                        || resource.data.cadeteId == meuCadete()));

      // lançar: nível 2 ou 3. Ninguém edita depois. Só o nível 3 pode excluir, e só enquanto a semana
      // da anotação está aberta (até sexta 18h = prazo − 3d 5h59min59s); fica registro em /exclusoes.
      allow create: if nivel(2) && anotacaoValida(request.resource.data);

      // o cadete só marca a hora em que enviou a defesa, e só até o prazo;
      // o nível 3 só grava a MCE na publicação da NAMCE (nunca altera o texto da anotação, nem anula);
      // depois de gravada, a MCE só muda se a decisão foi Transf. ou Aguardando decisão do Comando (vai para a NAMCE da semana seguinte)
      allow update: if (ativo()
          && resource.data.cadeteId == meuCadete()
          && resource.data.tipo == 'aad'
          && request.time <= resource.data.prazo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defesaEm'])
          && request.resource.data.defesaEm == request.time)
        // unir cadastros duplicados: o nível 3 passa a anotação de um cadastro SEM conta para o cadastro COM conta
        || (nivel(3)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cadeteId'])
          && get(/databases/$(database)/documents/cadetes/$(resource.data.cadeteId)).data.get('uid', '') == ''
          && get(/databases/$(database)/documents/cadetes/$(request.resource.data.cadeteId)).data.get('uid', '') != '')
        // ciência do resultado da NAMCE: o próprio cadete grava, uma vez por NAMCE, a hora (do servidor) em que viu a decisão
        || (ativo()
          && resource.data.cadeteId == meuCadete()
          && resource.data.keys().hasAny(['mce'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cienciaNamce'])
          && request.resource.data.cienciaNamce.keys().hasOnly(['namce', 'em'])
          && request.resource.data.cienciaNamce.namce == resource.data.mce.namce
          && request.resource.data.cienciaNamce.em == request.time
          && (!resource.data.keys().hasAny(['cienciaNamce']) || resource.data.cienciaNamce.namce != resource.data.mce.namce))
        // ciência: o próprio cadete, ao abrir "Minhas anotações", grava uma única vez a hora (do servidor) em que viu
        || (ativo()
          && resource.data.cadeteId == meuCadete()
          && !resource.data.keys().hasAny(['cienteEm'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cienteEm'])
          && request.resource.data.cienteEm == request.time)
        || (nivel(3)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mce'])
          && (!resource.data.keys().hasAny(['mce']) || resource.data.mce.decisao in ['transf', 'aguardando']));

      allow delete: if nivel(3) && request.time < resource.data.prazo - duration.value(280799, 's');

      // Defesa escrita: só o próprio cadete (até o prazo) e o nível 3.
      match /defesa/{docId} {
        function anot() { return get(/databases/$(database)/documents/anotacoes/$(aid)).data; }
        allow read: if nivel(3) || (ativo() && anot().cadeteId == meuCadete());
        function doCadeteNoPrazo() {
          return ativo() && anot().cadeteId == meuCadete() && anot().tipo == 'aad' && request.time <= anot().prazo;
        }
        // 'texto': a defesa escrita (obrigatória); 'imagem': 1 foto opcional, já reduzida no aparelho (até 900 KB)
        allow create, update: if doCadeteNoPrazo()
          && ((docId == 'texto'
                && request.resource.data.keys().hasOnly(['texto', 'temImagem', 'enviadaEm'])
                && txt(request.resource.data.texto, 1, 3000)
                && request.resource.data.get('temImagem', false) is bool
                && request.resource.data.enviadaEm == request.time)
            || (docId == 'imagem'
                && request.resource.data.keys().hasOnly(['dados', 'enviadaEm'])
                && request.resource.data.dados is bytes
                && request.resource.data.dados.size() <= 921600
                && request.resource.data.enviadaEm == request.time));
        // o cadete pode tirar a imagem até o prazo; o nível 3 apaga a defesa junto com a anotação excluída
        // (só enquanto a semana está aberta)
        allow delete: if (docId == 'imagem' && doCadeteNoPrazo())
          || (nivel(3) && request.time < anot().prazo - duration.value(280799, 's'));
      }
    }

    // ---------- Registro das anotações excluídas (não muda e não apaga) ----------
    match /exclusoes/{id} {
      allow read: if nivel(3);
      allow create: if nivel(3)
        && request.resource.data.excluidaPor == request.auth.uid
        && request.resource.data.excluidaEm == request.time
        && request.resource.data.prazo is timestamp
        && txt(request.resource.data.get('motivo', ''), 0, 500);
      allow update, delete: if false;
    }

    // ---------- Dosimetria (decisões; invisíveis ao cadete até a publicação) ----------
    match /dosimetria/{aid} {
      allow read, write: if nivel(3);
    }

    // ---------- NAMCEs (rascunho e publicadas) ----------
    // Depois de publicada, a NAMCE não muda mais (só pode receber a Planilha, se ainda não tiver);
    // depois de publicada, a Planilha de Anotados também não muda mais. Ninguém apaga.
    match /namces/{id} {
      function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow read, create: if nivel(3);
      allow update: if nivel(3)
        && (resource.data.get('status', '') != 'publicada' || mudou().hasOnly(['planilha']))
        && (resource.data.get('planilha', {}).get('status', '') != 'publicada' || !mudou().hasAny(['planilha']));
      allow delete: if false;
    }

    // ---------- Escalas de serviço (para bloquear conflitos) ----------
    match /escalas/{id} {
      allow read, delete: if nivel(3);
      allow create, update: if nivel(3)
        && request.resource.data.cadeteId is string
        && request.resource.data.inicio is timestamp
        && request.resource.data.fim is timestamp
        && request.resource.data.fim > request.resource.data.inicio
        && txt(request.resource.data.servico, 1, 200);
    }
  }
}
